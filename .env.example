# Copy values through your normal secret configuration, never frontend VITE_*.
# This file contains placeholders only. The server does not automatically load it.
# Node 22+: node --env-file=.env server/weather-server.mjs
QWEATHER_API_HOST=np3tegphmc.re.qweatherapi.com

# Configure EXACTLY ONE authentication method, not both.
# Preferred: externally issued Ed25519 JWT. It expires (maximum lifetime 24h).
# Replace it through secure server configuration and restart before expiration.
# Never put the signing private key or a real JWT in client code or this example.
QWEATHER_JWT=

# Alternative: API key. API-key daily request caps are announced for 2027-01-01.
QWEATHER_API_KEY=

HOST=127.0.0.1
PORT=8787

# Official docs: https://dev.qweather.com/en/docs/configuration/authentication/
# Weather cache 10 minutes, stale limit 1 hour; GeoAPI results are never cached.
# Display “Weather service by QWeather” linked to https://www.qweather.com,
# plus the response metadata.attributions. Requests use the account's quota.
