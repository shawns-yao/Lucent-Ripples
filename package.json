{
  "name": "stillwater-pixi-pond",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A quiet, interactive overhead koi pond rendered with PixiJS and WebGL",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "standalone": "node scripts/build-standalone.mjs",
    "wallpaper": "node scripts/build-wallpaper.mjs",
    "weather": "node --env-file=.env server/weather-server.mjs",
    "start": "node server/weather-server.mjs",
    "start:weather": "node --env-file=.env server/weather-server.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
